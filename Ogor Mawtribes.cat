          </characteristics>
        </profile>
        <profile id="37ffa375" name="Culling Knife" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon" hidden="false">
          <characteristics>
            <characteristic name="Atk" typeId="60e-35aa-31ed-e488">4</characteristic>
