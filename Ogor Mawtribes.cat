  <selectionEntries>
    <selectionEntry id="sph::scrapglutt::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="9d1edf4f" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="6ae5c56b" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="c90a2c79" name="Spearhead: Ogor Mawtribes (Scrapglutt)" hidden="false" targetId="sph-cat::scrapglutt" primary="true" />
        <categoryLink id="f8b080bb" name="Ogor Mawtribes" hidden="false" targetId="sph-faction::ogor-mawtribes" primary="false" />
        <categoryLink id="27de97e4" name="Destruction" hidden="false" targetId="sph-alliance::destruction" primary="false" />
        <categoryLink id="ab6907d7" name="Legends" hidden="false" targetId="sph-flag::legends" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="56a2a0d6" name="Better Late Than Never" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">A unit of Ironguts with 4 models is not set up during the deployment phase. Instead, in the third battle round, that unit can use the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile id="614c6da4" name="Let's Get Stuck In" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit wholly within friendly territory, wholly within 6&quot; of the battlefield edge, and not in combat.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="27e7a5b3" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="55eb500b" name="It's a Hard Life" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Gnoblars unit within your general's combat range to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+: Heal (X) your general where X is an amount equal to the roll. 1 model in that Gnoblars unit is slain.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="8ab11208" name="Frenzied Artillery" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If the unmodified charge roll for a friendly Gnoblar Scraplauncher is 6+, add 3 the Attacks characteristic of the target's Companion weapons for the rest of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="3689789a" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="9a55f149" name="Savage Instincts" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a Fight ability for your general</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly unit that has not used a Fight ability this turn and is within your general's combat range to be the target. The target can be picked to use a Fight ability immediately after the Fight ability used by your general has been resolved.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="51826323" name="Nasty Trap" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Give the target your general's Trap token. While the target has a Trap token, each time the target is picked to use a Move or Charge ability, roll a dice. On a 4+, that Move or Charge ability has no effect and the target's Trap token is removed.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="3d1ba8be" name="Massive Bulk" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 2 to the Health characteristic of your general.</characteristic>
          </characteristics>
        </profile>
        <profile id="3f0d6fbd" name="Veteran Hunter" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the Rend characteristic of your general's combat attacks that target that unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
