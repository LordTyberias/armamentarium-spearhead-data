            <characteristic name="Dmg" typeId="e948-9c71-12a6-6be4">2</characteristic>
            <characteristic name="Ability" typeId="eda3-7332-5db1-4159">-</characteristic>
          </characteristics>
        </profile>
        <profile id="fa6c5da8" name="Staying Useful" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While any of this unit's Gnoblar or Frost Sabre tokens are on the battlefield, this unit has Ward (5+). Each time you make a successful ward roll for this unit, remove 1 of this unit's tokens from the battlefield. If this unit's Frost Sabre token has been removed, it can no longer attack with its Frost Sabre's Fangs.</characteristic>
          </characteristics>
        </profile>
        <profile id="99d60eb4" name="No Slacking!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Infantry unit wholly within 12&quot; of this unit.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice On a 3+, add the result to the target's control score until the start of your next turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
