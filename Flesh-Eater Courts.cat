        <profile id="9cff11de" name="Lie of the Land" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is not in combat and is wholly within 6&quot; of a battlefield edge, remove this unit from the battlefield and set it up again wholly within 6&quot; of a battlefield edge and more than 6&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
