        </profile>
        <profile id="fad4752f" name="Guardians" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While your general is wholly within this unit's combat range, both this unit and your general have Ward (5+).</characteristic>
          </characteristics>
        </profile>
