            <characteristic name="Ability" typeId="eda3-7332-5db1-4159">Crit (Mortal), Anti-Infantry (+1 Rend)</characteristic>
          </characteristics>
        </profile>
        <profile id="7ed57b0b" name="Swordmasters" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time this unit uses a Fight ability, you must pick either the Perfect Strike or Flurry of Blows weapon characteristics for all the attacks it makes with its Sunmetal Greatblade. In addition: Do not use the attack sequence for an attack made with Perfect Strike. Instead, roll a dice. On a 2+, inflict 1 mortal damage on the target unit.</characteristic>
