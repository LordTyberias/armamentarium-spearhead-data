        <profile id="06f4f12d" name="Ritual of the Creeping Mist" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly unit wholly within 12&quot; of this unit to be the target, then roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 3+, until the start of your next turn, subtract 1 from wound rolls for attacks that target that unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
