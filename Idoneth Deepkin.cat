    <selectionEntry id="sph::soulraid-hunt::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="9d7ab7df" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="4dba8eb7" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="d7c483c2" name="Spearhead: Idoneth Deepkin (Soulraid Hunt)" hidden="false" targetId="sph-cat::soulraid-hunt" primary="true" />
        <categoryLink id="c67f32ed" name="Idoneth Deepkin" hidden="false" targetId="sph-faction::idoneth-deepkin" primary="false" />
        <categoryLink id="d09bbf0b" name="Order" hidden="false" targetId="sph-alliance::order" primary="false" />
        <categoryLink id="5b159771" name="Legends" hidden="false" targetId="sph-flag::legends" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="978bb62f" name="Tides of Death" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In each battle round, all friendly units have the Tides of Death passive ability that corresponds to the current battle round number. Battle round 1, Low Tide: Subtract 1 from hit rolls for shooting attacks that target this unit. Battle round 2, Flood Tide: This unit can use a Run ability and still use Shoot and/or Charge abilities later in the turn. Battle round 3, High Tide: This unit has Strike-first. Battle round 4, Ebb Tide: This unit can use a Retreat ability and still use Shoot and/or Charge abilities later in the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="69dc7ea0" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="0e641e3a" name="Way of the Cresting Wave" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Rend characteristic of melee weapons used by friendly Namarti Thralls units that charged in the same turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="785e81ef" name="Ethersea Predators" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly Cavalry unit that used a Fight ability this turn. Heal (D3) that unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="d56d6c32" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="b974a696" name="Arch-Ritualist" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to rolls for your general's 'Ritual of the Creeping Mist' ability.</characteristic>
          </characteristics>
        </profile>
        <profile id="c7910a18" name="Steelshell Armour" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore all modifiers to save rolls for your general (positive and negative).</characteristic>
          </characteristics>
        </profile>
        <profile id="c43f5f5d" name="Mind Flare" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with your general.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Until the end of the phase, attacks made by that unit only score hits on unmodified hit rolls of 6.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="8bf518ed" name="Delicious Morsels" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Heal (1) each friendly Cavalry unit within your general's combat range.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
