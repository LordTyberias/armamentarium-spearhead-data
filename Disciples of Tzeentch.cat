        </profile>
        <profile id="ad92de86" name="Slashing Fins" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that any models in this unit passed across this phase to be the target, then roll a dice for each model in this unit that did so.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For each 4+, inflict 1 mortal damage on the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
