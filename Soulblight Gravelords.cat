        <profile id="daf3e08f" name="Vile Transference" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 6&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 6+, roll a number of dice equal to the target's Health characteristic. For each 5+, inflict 1 mortal damage on the target and Heal (1) this unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
