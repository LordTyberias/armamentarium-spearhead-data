    <selectionEntry id="sph::bloodwind-legion::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="4c598064" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="d2a3ba62" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="eee556e6" name="Spearhead: Slaves to Darkness (Bloodwind Legion)" hidden="false" targetId="sph-cat::bloodwind-legion" primary="true" />
        <categoryLink id="09c36944" name="Slaves to Darkness" hidden="false" targetId="sph-faction::slaves-to-darkness" primary="false" />
        <categoryLink id="b578866b" name="Chaos" hidden="false" targetId="sph-alliance::chaos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="15165694" name="Eye of the Gods" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick one of the following friendly units to use this ability: A unit that is contesting an objective not controlled by your opponent and is not in combat. A unit that destroyed an enemy unit this turn.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll once on the Eye of the Gods table for that unit. That unit gains the Eye of the Gods passive ability that corresponds to the roll (the unit keeps all Eye of the Gods abilities gained in previous turns). If the same unit gains the same ability more than once in the battle, the effects are not cumulative. 1 Snubbed by the Gods: No effect. 2 Ward of Tzeentch: This unit has Ward (6+). 3 Grace of Slaanesh: Add 1 to run rolls for this unit. 4 Blessing of Nurgle: Subtract 1 from wound rolls for attacks that target this unit. 5 Fury of Khorne: Add 1 to the Rend characteristic of this unit's melee weapons. 6 Champion of Chaos: Pick any ability from the table.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="2440a151" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="ca31ea75" name="The Dread Banner" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Start of the First Battle Round</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Chaos Warriors or Chaos Knights unit.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can immediately roll on the Eye of the Gods table for that unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="930ed54e" name="Fierce Conquerors" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 3 to the control scores of friendly Chaos Warriors units.</characteristic>
          </characteristics>
        </profile>
        <profile id="a5dcad04" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="7152ca28" name="Mark of Khorne" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Rend characteristic of your general's melee weapons if they charged in the same turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="68568a4b" name="Mark of Tzeentch" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit on the battlefield. You cannot pick your general.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove that unit from the battlefield and set it up again wholly within 6&quot; of your general and more than 6&quot; from all enemy units. It cannot use Move abilities for the rest of the phase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="03bf67e5" name="Mark of Nurgle" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from wound rolls for combat attacks that target your general.</characteristic>
          </characteristics>
        </profile>
        <profile id="801da440" name="Mark of Slaanesh" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Your general has Strike-first.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
