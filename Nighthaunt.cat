  <selectionEntries>
    <selectionEntry id="sph::cursed-shacklehorde::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="f984e55c" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="87062bdb" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="864ecb52" name="Spearhead: Nighthaunt (Cursed Shacklehorde)" hidden="false" targetId="sph-cat::cursed-shacklehorde" primary="true" />
        <categoryLink id="976f8177" name="Nighthaunt" hidden="false" targetId="sph-faction::nighthaunt" primary="false" />
        <categoryLink id="591e921e" name="Death" hidden="false" targetId="sph-alliance::death" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="73a7b83e" name="Spectral Procession" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">1 of your Bladegheist Revenants units and 1 of your Dreadscythe Harridans units start the battle in reserve. From the second battle round onwards, you can use the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile id="da9308d1" name="Cackling Arrival" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick 1 of your units in reserve.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up that unit anywhere on the battlefield more than 6&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="ca8b6a4a" name="Ethereal" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore negative modifiers to save rolls for friendly units.</characteristic>
          </characteristics>
        </profile>
        <profile id="6ae517f1" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="ad5b7090" name="Discorporate" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, add 1 to save rolls for the target for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="52e1d437" name="Mounting Dread" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2+, subtract the current battle round number from the control scores of enemy units while they are in combat with the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="4756cadd" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="a1b745fd" name="Unholy Visage" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 6&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, the target must immediately use a Retreat ability as if it were the enemy movement phase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="3c1bf2bf" name="Tales of Horror" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy Infantry or Cavalry unit within 6&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle, if the target is replaced using the 'Call for Reinforcements' ability, halve the number of models in the replacement unit, rounding up.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="7ead719c" name="Deathly Possessor" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy Hero within 12&quot; of your general to be the target, then pick another enemy unit within the target's combat range to be the victim.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, pick one: Inflict mortal damage on the target equal to the roll. Inflict mortal damage on the victim equal to the roll.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="a4b9dd27" name="Spectral Howl" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
