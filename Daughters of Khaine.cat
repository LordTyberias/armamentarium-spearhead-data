            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 1&quot; of this unit to be the target and roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 2+, inflict 1 mortal damage on the target.</characteristic>
