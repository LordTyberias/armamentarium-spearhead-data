        <profile id="bba10561" name="Stuff 'Em In Me Bag" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target, then roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the roll is at least double the target unit's Health characteristic, 1 model in that unit is slain.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="bdc0022e" name="Timber!" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this model is slain, before removing it from the battlefield, the players must roll off. The winner picks a point on the battlefield up to 3&quot; from this model. Inflict D3 mortal damage on each enemy unit within 2&quot; of that point. This model is then removed from the battlefield.</characteristic>
          </characteristics>
        </profile>
      </profiles>
