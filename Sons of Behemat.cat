            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target, then roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the roll is at least double the target unit's Health characteristic, 1 model in that unit is slain.</characteristic>
