<catalogue id="sph-catalogue::sons-of-behemat" name="Sons of Behemat" gameSystemId="sph1-6c4a-2e97-0001" revision="1" battleScribeVersion="2.03" authorName="Armamentarium" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <selectionEntries>
    <selectionEntry id="sph::wallsmasher-stomp::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="5eee883b" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="82d06f5c" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="8627478d" name="Spearhead: Sons of Behemat (Wallsmasher Stomp)" hidden="false" targetId="sph-cat::wallsmasher-stomp" primary="true" />
        <categoryLink id="0c885495" name="Sons of Behemat" hidden="false" targetId="sph-faction::sons-of-behemat" primary="false" />
        <categoryLink id="54348fa4" name="Destruction" hidden="false" targetId="sph-alliance::destruction" primary="false" />
        <categoryLink id="7cbb2a7f" name="Legends" hidden="false" targetId="sph-flag::legends" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="23bf44e6" name="Bullstomper" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mancrusher Mobs are led by fearsome gargants known as Bullstompers. Your general has the Hero keyword (in addition to the Monster keyword) but does not have the Reinforcements keyword or icon.</characteristic>
          </characteristics>
        </profile>
        <profile id="53e62792" name="Bellowing Roar" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit to use this ability, pick an enemy unit in combat with it to be the target, then roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 2+, subtract 1 from hit rolls for attacks made by the target unit this phase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="bb4d4a9b" name="'Grab Those Rocks and Chuck 'Em!'" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick your general to use this ability, then pick another friendly unit wholly within 12&quot; of them.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to the Attacks characteristic of that unit's Throwin' Rocks this turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="733414bf" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="95439636" name="Foe-chompers" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time an enemy model is slain by a friendly unit's 'Stuff 'Em In Me Bag' ability, Heal (D3) that unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="5f50dd84" name="Earth-shaking Charge" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Phase (Army), Any Charge Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that charged this phase to use this ability, then roll a dice for each enemy unit in combat with it.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 3+, that enemy unit has Strike-last this turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="91f09ea4" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="e19c33cd" name="Monstrously Tough" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Your general has a Health characteristic of 15 instead of 12.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe9bba30" name="Extra-big Bag" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When your general uses their 'Stuff 'Em In Me Bag' ability, you can pick 2 enemy units instead of 1 (roll for each).</characteristic>
          </characteristics>
        </profile>
        <profile id="2576b525" name="Lanky Git" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When you make a charge roll for your general, roll 3D6 instead of 2D6.</characteristic>
          </characteristics>
        </profile>
        <profile id="6ee2cd77" name="Furiously Territorial" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for attacks made by your general that target an enemy unit that is contesting an objective you do not control.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
