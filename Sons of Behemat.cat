    <selectionEntry id="sph::stone-lobbas::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="09d07d33" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="0e685dbe" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="8c14dce0" name="Spearhead: Sons of Behemat (Stone Lobbas)" hidden="false" targetId="sph-cat::stone-lobbas" primary="true" />
        <categoryLink id="bdb8f63c" name="Sons of Behemat" hidden="false" targetId="sph-faction::sons-of-behemat" primary="false" />
        <categoryLink id="4fb3ffa6" name="Destruction" hidden="false" targetId="sph-alliance::destruction" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="18d44b87" name="Boulder Basher" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mobs of Stone Lobbas are led by demanding, and uncannily accurate, gargants known as Boulder Bashers. Add the Hero keyword to your general's warscroll and remove the Reinforcements keyword.</characteristic>
          </characteristics>
        </profile>
        <profile id="3cd35fee" name="Bowled Over" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Shooting Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit that was allocated any damage points by a friendly unit's shooting attacks this turn to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, until the start of your next turn, each time your opponent makes a charge roll for the target, they must change the highest D6 to match the lowest D6.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="c9d5df13" name="Close One Eye!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick your general to use this ability, then pick another friendly unit wholly within 12&quot; of them to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to hit rolls for the target's shooting attacks for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="25c7eb1b" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="7ed28ef6" name="Surly Sorts" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit in combat to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to the Attacks characteristic of the target's melee weapons for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="fc5d8314" name="Greedy and Grabby" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 5 to the control scores of friendly units.</characteristic>
          </characteristics>
        </profile>
        <profile id="30c5f3eb" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="afc66553" name="'Ard 'Ead" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to hit rolls for combat attacks made with your general's 'Eadbutt for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="f5d7806b" name="Lucky Rock" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Shooting Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to the Attacks characteristic of your general's Hurlin' Rocks for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="3f95f185" name="Humongous Strides" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to charge rolls for your general.</characteristic>
          </characteristics>
        </profile>
        <profile id="1dd83547" name="Hungry Gobbler" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If any enemy models were slain by your general's combat attacks this turn, Heal (D3) your general.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
