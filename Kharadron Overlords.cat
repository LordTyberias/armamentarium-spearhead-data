  <selectionEntries>
    <selectionEntry id="sph::skyhammer-task-force::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="5528efa3" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="de82a098" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="fed0899e" name="Spearhead: Kharadron Overlords (Skyhammer Task Force)" hidden="false" targetId="sph-cat::skyhammer-task-force" primary="true" />
        <categoryLink id="1750b16d" name="Kharadron Overlords" hidden="false" targetId="sph-faction::kharadron-overlords" primary="false" />
        <categoryLink id="5bc46634" name="Order" hidden="false" targetId="sph-alliance::order" primary="false" />
        <categoryLink id="7c28085f" name="Legends" hidden="false" targetId="sph-flag::legends" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="b5dd4d70" name="Ply the Skies" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a non-Charge Move ability for an Arkanaut Frigate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly Infantry unit that is wholly within the combat range of that Arkanaut Frigate and not in combat to be transported. Remove that Infantry unit from the battlefield. Then, when the Arkanaut Frigate ends its move, set up the Infantry unit on the battlefield again, wholly within the combat range of the Arkanaut Frigate and not in combat. A unit cannot use Charge abilities if it was transported in the same turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">The Arkanaut Frigate that is using that Move ability.</characteristic>
          </characteristics>
        </profile>
        <profile id="82df6151" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="6a77587d" name="Assault Boat" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that was transported this turn to use this ability.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">That unit can still use Charge abilities later in the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="10b1f2b5" name="Disengage" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Arkanaut Frigate to use this ability.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If that unit uses a Retreat ability this phase, no mortal damage is inflicted on it and it can still use Shoot abilities later in the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="c782272f" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="3f2854cb" name="Masterwrought Armour" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Your general has Ward (6+).</characteristic>
          </characteristics>
        </profile>
        <profile id="5d45aa6d" name="Flask of Vintage Gorogna" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Heal (D6) your general.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="1ec80cac" name="There's No Reward Without Risk" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Reaction: You declared a Charge ability for a unit wholly within 12&quot; of your general</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"></characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can re-roll the charge roll for that Charge ability.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="a951ea0e" name="Leave No Duardin Behind" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Arkanaut Company unit wholly within 12&quot; of your general and roll a dice for each slain model from that unit.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For each 4+, you can return 1 slain model to that unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
