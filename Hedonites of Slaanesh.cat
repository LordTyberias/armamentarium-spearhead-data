    <selectionEntry id="sph::epicurean-revellers::00-battle-traits" name="Battle Traits" type="unit" hidden="false">
      <constraints>
        <constraint id="8f2067ef" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="86fe9670" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="56742b02" name="Spearhead: Hedonites of Slaanesh (Epicurean Revellers)" hidden="false" targetId="sph-cat::epicurean-revellers" primary="true" />
        <categoryLink id="c6643ed0" name="Hedonites of Slaanesh" hidden="false" targetId="sph-faction::hedonites-of-slaanesh" primary="false" />
        <categoryLink id="327990d4" name="Chaos" hidden="false" targetId="sph-alliance::chaos" primary="false" />
        <categoryLink id="d4a2d53f" name="Legends" hidden="false" targetId="sph-flag::legends" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="87803c8d" name="Favour Most Fickle" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The following effects apply based on the number of friendly units on the battlefield. These effects are not cumulative: 5 or more units: Add 2 to the Control characteristic of friendly units. 4 units: Add 1 to hit rolls and wound rolls for friendly units' combat attacks, including attacks made with Companion weapons. 3 units: Add 1 to run rolls and charge rolls for friendly units. 2 units: Friendly units have Ward (5+). 1 unit: Add 2 to the Attacks characteristic of friendly units' melee weapons, including Companion weapons.</characteristic>
          </characteristics>
        </profile>
        <profile id="91c1a6e3" name="Regiment Abilities" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Pick 1 of the following regiment abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="2bfe4f23" name="Bringers of Degradation" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When players are alternating picking units to use a Fight ability, when it is your turn to pick a unit, you can pick 2 friendly Daemonettes units instead of 1 unit. Resolve the second Fight ability immediately after the first.</characteristic>
          </characteristics>
        </profile>
        <profile id="b1e39b04" name="Daemonic Onslaught" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly Seekers or Fiends unit wholly within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target can use the 'Normal Move' ability as if it were your movement phase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="85803ed0" name="Enhancements" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Give your general 1 of the following enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile id="6e371472" name="Twisted Grace" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When your general makes a pile-in move, if they charged in the same turn, add D6&quot; to the distance they can move.</characteristic>
          </characteristics>
        </profile>
        <profile id="8b406a97" name="High Courtiers" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While your general is wholly within the combat range of a friendly Daemonettes unit, both units have Ward (5+).</characteristic>
          </characteristics>
        </profile>
        <profile id="2618d27f" name="Excess of Violence" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly unit wholly within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">The target's melee weapons, including Companion weapons, have Crit (2 Hits) until the start of your next turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
        <profile id="42ff056d" name="Irresistible Soul-musk" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly Seekers or Fiends unit wholly within 12&quot; of your general to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove the target from the battlefield and set it up again on the battlefield more than 6&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
