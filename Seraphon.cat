        <profile id="e3336f62" name="Dartpipe" typeId="1fd-a42f-41d3-fe05" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Rng" typeId="c6b5-908c-a604-1a98">10&quot;</characteristic>
