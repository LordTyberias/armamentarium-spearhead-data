        <constraint id="b7e92554" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="0ec87edd" name="Spearhead: Seraphon (Starscale Warhost)" hidden="false" targetId="sph-cat::starscale-warhost" primary="true" />
        <categoryLink id="e5a97227" name="Seraphon" hidden="false" targetId="sph-faction::seraphon" primary="false" />
