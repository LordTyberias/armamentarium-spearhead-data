        <profile id="26f5c0dd" name="Unit Composition" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The models in this unit are 1 Sunblood and 2 Saurus Bodyguard. Each model is armed with Celestite Weapons. This unit's Venomites are a token.</characteristic>
          </characteristics>
        </profile>
        <profile id="2ff655f3" name="Scaled Protectors" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit includes a Sunblood, ignore the first damage point that would be allocated to this unit each phase and add 1 to this unit's control score.</characteristic>
          </characteristics>
        </profile>
        <profile id="9cfb7247" name="Savage Bellow" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly unit wholly within 12&quot; of this unit to be the target and roll a dice.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">On a 3+, the target's weapons have Crit (2 Hits) for the rest of the turn, including Companion weapons.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"></characteristic>
