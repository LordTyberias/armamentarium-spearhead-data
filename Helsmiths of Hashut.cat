        </profile>
        <profile id="93f4e078" name="Black-hearted Conqueror" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has any daemonic power points, friendly units with 0 daemonic power points count as having 1 daemonic power point while they are wholly within 6&quot; of and visible to this unit. For each daemonic power point this unit has, add 3&quot; to the range of this ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
