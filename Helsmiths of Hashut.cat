          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to hit rolls for this unit's shooting attacks that target an enemy unit with 5 or more models that is more than 12&quot; from this unit.</characteristic>
